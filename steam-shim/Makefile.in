MODULE    = steam.exe
# CXX_PE_LIBS is Wine's own PE libc++, libc++abi, libunwind, msvcp140 and vcruntime140.
# mingw's libstdc++ mismatches these and leaves std::basic_string and
# _Unwind_SjLj_Resume undefined. dlls/dmsynth imports the same way.
IMPORTS   = $(CXX_PE_LIBS) user32 advapi32 shlwapi shell32 msi ole32

EXTRADLLFLAGS = -mwindows -mcygwin -static-libgcc
# __WINESRC__ is explicit for the amalgamated Valve sources, so ERR() and ARRAY_SIZE()
# are hidden without it. PATH_MAX is defined because mingw's limits.h has none.
EXTRADEFS = -DWINE_NO_LONG_TYPES -D__WINESRC__ -DPATH_MAX=4096

EXTRAINCL = \
	-I$(srcdir)/proton-headers/steamworks_sdk_142 \
	-I$(srcdir)/proton-headers/openvr/headers \
	-I$(srcdir)/proton-headers/wine/include

SOURCES = \
	jsoncpp.cpp \
	steam.cpp
