Register dlls/lsteamclient and programs/steam.exe with Wine 11.0's build system.

EXTLIB is set in programs/steam.exe/Makefile.in so makedep does not follow the
internal includes inside jsoncpp's amalgamation.

diff --git a/configure b/configure
--- a/configure
+++ b/configure
@@ -1221,6 +1221,7 @@
 enable_loadperf
 enable_localspl
 enable_localui
+enable_lsteamclient
 enable_lz32
 enable_magnification
 enable_mapi32
@@ -1749,7 +1749,8 @@
 enable_shutdown
 enable_sort
 enable_spoolsv
 enable_start
+enable_steam_exe
 enable_subst
 enable_svchost
 enable_systeminfo
@@ -22695,7 +22695,8 @@
 wine_fn_config_makefile dlls/localspl enable_localspl
 wine_fn_config_makefile dlls/localspl/tests enable_tests
 wine_fn_config_makefile dlls/localui enable_localui
 wine_fn_config_makefile dlls/localui/tests enable_tests
+wine_fn_config_makefile dlls/lsteamclient enable_lsteamclient
 wine_fn_config_makefile dlls/lz32 enable_lz32
 wine_fn_config_makefile dlls/lz32/tests enable_tests
 wine_fn_config_makefile dlls/lzexpand.dll16 enable_win16
@@ -23472,5 +23472,6 @@
 wine_fn_config_makefile programs/sort enable_sort
 wine_fn_config_makefile programs/spoolsv enable_spoolsv
 wine_fn_config_makefile programs/start enable_start
+wine_fn_config_makefile programs/steam.exe enable_steam_exe
 wine_fn_config_makefile programs/subst enable_subst
 wine_fn_config_makefile programs/svchost enable_svchost

diff --git a/configure.ac b/configure.ac
--- a/configure.ac
+++ b/configure.ac
@@ -2837,7 +2837,8 @@
 WINE_CONFIG_MAKEFILE(dlls/localspl)
 WINE_CONFIG_MAKEFILE(dlls/localspl/tests)
 WINE_CONFIG_MAKEFILE(dlls/localui)
 WINE_CONFIG_MAKEFILE(dlls/localui/tests)
+WINE_CONFIG_MAKEFILE(dlls/lsteamclient)
 WINE_CONFIG_MAKEFILE(dlls/lz32)
 WINE_CONFIG_MAKEFILE(dlls/lz32/tests)
 WINE_CONFIG_MAKEFILE(dlls/lzexpand.dll16)
@@ -3613,5 +3613,6 @@
 WINE_CONFIG_MAKEFILE(programs/sort)
 WINE_CONFIG_MAKEFILE(programs/spoolsv)
 WINE_CONFIG_MAKEFILE(programs/start)
+WINE_CONFIG_MAKEFILE(programs/steam.exe)
 WINE_CONFIG_MAKEFILE(programs/subst)
 WINE_CONFIG_MAKEFILE(programs/svchost)
